-- ============================================
-- Funções auxiliares
-- ============================================
local function GetFOVCenter()
    if Config.FOVMode == "Mouse" then
        return UserInputService:GetMouseLocation()
    end
    local v = Camera.ViewportSize
    return Vector2.new(v.X / 2, v.Y / 2)
end

local function IsVisible(targetPart)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
    rayParams.IgnoreWater = true
    local origin = Camera.CFrame.Position
    local result = Workspace:Raycast(origin, targetPart.Position - origin, rayParams)
    if not result then return true end
    return result.Instance:IsDescendantOf(targetPart.Parent)
end

local function GetClosestPlayer(partName)
    partName = partName or Config.AimPart
    local target, shortest = nil, Config.FOVRadius
    local center = GetFOVCenter()

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if Config.TeamCheck and player.Team == LocalPlayer.Team then continue end
                local part = player.Character:FindFirstChild(partName)
                if part then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if dist < shortest then
                            if not Config.WallCheck or IsVisible(part) then
                                shortest = dist
                                target = part
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

-- ============================================
-- Hitbox
-- ============================================
local function ApplyHitbox(player)
    if player == LocalPlayer or not player.Character then return end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
        hrp.Transparency = Config.HitboxTransparency
        hrp.BrickColor = BrickColor.new(Config.HitboxColor)
        hrp.Material = Enum.Material.Neon
        hrp.CanCollide = false
    end
end

local function ResetHitbox(player)
    if not player.Character then return end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Size = Vector3.new(2, 2, 1)
        hrp.Transparency = 1
        hrp.Material = Enum.Material.Plastic
    end
end

-- ============================================
-- Silent Aim Hook
-- ============================================
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    if Config.SilentAimEnabled and getnamecallmethod() == "Raycast" and self == Workspace then
        if math.random(0, 100) <= Config.SilentAimChance then
            local target = GetClosestPlayer(Config.SilentAimPart)
            if target then
                local args = {...}
                local origin = args[1]
                local dir = args[2]
                args[2] = (target.Position - origin).Unit * dir.Magnitude
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)

setreadonly(mt, true)

-- ============================================
-- Bounding Box
-- ============================================
local function GetBox(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local sp, on = Camera:WorldToViewportPoint(hrp.Position)
    if not on then return nil end
    local ext = char:GetExtentsSize()
    local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
    local h = (ext.Y * Camera.ViewportSize.Y) / (2 * dist * math.tan(math.rad(Camera.FieldOfView) / 2))
    local w = h * (ext.X / ext.Y)
    return { center = Vector2.new(sp.X, sp.Y), h = h, w = w, bottomY = sp.Y + h / 2 }
end

-- ============================================
-- ESP Cache
-- ============================================
local function EnsureESP(player)
    if ESPCache[player] then return ESPCache[player] end
    local bones = {}
    for i = 1, 17 do
        bones[i] = Drawing.new("Line")
        bones[i].Thickness = 1
        bones[i].Visible = false
    end
    ESPCache[player] = {
        Name = Drawing.new("Text"),
        Distance = Drawing.new("Text"),
        HealthBarBg = Drawing.new("Line"),
        HealthBar = Drawing.new("Line"),
        Bones = bones,
    }
    return ESPCache[player]
end

local function HideAllESP()
    for _, cache in pairs(ESPCache) do
        cache.Name.Visible = false
        cache.Distance.Visible = false
        cache.HealthBar.Visible = false
        cache.HealthBarBg.Visible = false
        for _, b in ipairs(cache.Bones) do b.Visible = false end
    end
end

-- ============================================
-- Bones
-- ============================================
local function GetBonePoints(char)
    local function p(name)
        local part = char:FindFirstChild(name)
        if part then
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            if on then return Vector2.new(sp.X, sp.Y) end
        end
        return nil
    end
    return {
        Head = p("Head"),
        UpperTorso = p("UpperTorso") or p("Torso"),
        LowerTorso = p("LowerTorso"),
        LeftUpperArm = p("LeftUpperArm") or p("Left Arm"),
        LeftLowerArm = p("LeftLowerArm"),
        LeftHand = p("LeftHand"),
        RightUpperArm = p("RightUpperArm") or p("Right Arm"),
        RightLowerArm = p("RightLowerArm"),
        RightHand = p("RightHand"),
        LeftUpperLeg = p("LeftUpperLeg") or p("Left Leg"),
        LeftLowerLeg = p("LeftLowerLeg"),
        LeftFoot = p("LeftFoot"),
        RightUpperLeg = p("RightUpperLeg") or p("Right Leg"),
        RightLowerLeg = p("RightLowerLeg"),
        RightFoot = p("RightFoot"),
    }
end

local function DrawBones(cache, pts, color)
    local bones = cache.Bones
    local i = 0
    local function line(a, b)
        i = i + 1
        if a and b and bones[i] then
            bones[i].From = a
            bones[i].To = b
            bones[i].Color = color
            bones[i].Visible = true
        end
    end
    line(pts.Head, pts.UpperTorso)
    if pts.LowerTorso then line(pts.UpperTorso, pts.LowerTorso) end
    line(pts.UpperTorso, pts.LeftUpperArm)
    line(pts.LeftUpperArm, pts.LeftLowerArm)
    line(pts.LeftLowerArm, pts.LeftHand)
    line(pts.UpperTorso, pts.RightUpperArm)
    line(pts.RightUpperArm, pts.RightLowerArm)
    line(pts.RightLowerArm, pts.RightHand)
    local lowerBody = pts.LowerTorso or pts.UpperTorso
    line(lowerBody, pts.LeftUpperLeg)
    line(pts.LeftUpperLeg, pts.LeftLowerLeg)
    line(pts.LeftLowerLeg, pts.LeftFoot)
    line(lowerBody, pts.RightUpperLeg)
    line(pts.RightUpperLeg, pts.RightLowerLeg)
    line(pts.RightLowerLeg, pts.RightFoot)
end

-- ============================================
-- Update ESP
-- ============================================
local function UpdateESP()
    HideAllESP()
    if not Config.ESPEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer and not Config.ESPLocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local cache = EnsureESP(player)
        local box = GetBox(char)
        if not box then continue end

        local color = (Config.ESPTeam and player.TeamColor and player.TeamColor.Color) or Color3.fromRGB(255, 255, 255)

        if Config.ESPName then
            local head = char:FindFirstChild("Head")
            if head then
                local hp, on = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                if on then
                    cache.Name.Text = player.Name
                    cache.Name.Size = 14
                    cache.Name.Center = true
                    cache.Name.Outline = true
                    cache.Name.Color = color
                    cache.Name.Position = Vector2.new(hp.X, hp.Y - 10)
                    cache.Name.Visible = true
                end
            end
        end

        local bottomY = box.bottomY
        if Config.ESPDistance then
            local dist = (Camera.CFrame.Position - char.HumanoidRootPart.Position).Magnitude
            cache.Distance.Text = math.floor(dist) .. " studs"
            cache.Distance.Size = 12
            cache.Distance.Center = true
            cache.Distance.Outline = true
            cache.Distance.Color = color
            cache.Distance.Position = Vector2.new(box.center.X, bottomY + 5)
            cache.Distance.Visible = true
            bottomY = bottomY + 20
        end

        if Config.ESPHealth then
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local barW = box.w
            local barH = 6
            local barX = box.center.X - barW / 2
            local barY = bottomY + 8

            cache.HealthBarBg.From = Vector2.new(barX, barY)
            cache.HealthBarBg.To   = Vector2.new(barX + barW, barY)
            cache.HealthBarBg.Color = Color3.fromRGB(0, 0, 0)
            cache.HealthBarBg.Thickness = barH
            cache.HealthBarBg.Transparency = 1
            cache.HealthBarBg.Visible = true

            local r, g
            if pct > 0.5 then
                r = 255 * (1 - (pct - 0.5) * 2)
                g = 255
            else
                r = 255
                g = 255 * (pct * 2)
            end

            cache.HealthBar.From = Vector2.new(barX, barY)
            cache.HealthBar.To   = Vector2.new(barX + barW * pct, barY)
            cache.HealthBar.Color = Color3.fromRGB(r, g, 0)
            cache.HealthBar.Thickness = barH - 2
            cache.HealthBar.Transparency = 1
            cache.HealthBar.Visible = true
        end

        if Config.ESPBones then
            local pts = GetBonePoints(char)
            DrawBones(cache, pts, color)
        end
    end
end

-- ============================================
-- SnapLines
-- ============================================
local function UpdateSnapLines()
    for _, line in pairs(SnapLineCache) do line.Visible = false end
    if not Config.SnapLines then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myTool = myChar:FindFirstChildOfClass("Tool")
    if not myTool then return end
    local myHandle = myTool:FindFirstChild("Handle")
    if not myHandle then return end

    local myPos, myOn = Camera:WorldToViewportPoint(myHandle.Position)
    if not myOn then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or not player.Character then continue end
        local head = player.Character:FindFirstChild("Head")
        if not head then continue end
        local hp, on = Camera:WorldToViewportPoint(head.Position)
        if not on then continue end

        if not SnapLineCache[player] then
            SnapLineCache[player] = Drawing.new("Line")
        end
        local line = SnapLineCache[player]
        line.From = Vector2.new(myPos.X, myPos.Y)
        line.To = Vector2.new(hp.X, hp.Y)
        line.Color = (Config.ESPTeam and player.TeamColor and player.TeamColor.Color) or Color3.fromRGB(255, 255, 255)
        line.Thickness = 1
        line.Visible = true
    end
end

-- ============================================
-- Dropped Tools
-- ============================================
local DroppedToolsFolder = Workspace:WaitForChild("DroppedTools", 10)

local function UpdateDroppedTools()
    for _, d in pairs(DroppedToolCache) do d.Visible = false end
    if not Config.ESPDroppedTools or not DroppedToolsFolder then return end

    for _, obj in ipairs(DroppedToolsFolder:GetChildren()) do
        local handle = obj:FindFirstChild("Handle")
            or (obj:IsA("Model") and obj.PrimaryPart)
        if handle then
            local sp, onScreen = Camera:WorldToViewportPoint(handle.Position)
            if onScreen then
                if not DroppedToolCache[obj] then
                    DroppedToolCache[obj] = Drawing.new("Text")
                end
                local d = DroppedToolCache[obj]
                d.Text = obj.Name
                d.Size = 18
                d.Center = true
                d.Outline = true
                d.Color = Color3.fromRGB(255, 200, 0)
                d.Position = Vector2.new(sp.X, sp.Y)
                d.Visible = true
            end
        end
    end
end

