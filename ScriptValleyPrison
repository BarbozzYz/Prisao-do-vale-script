RunService.RenderStepped:Connect(function()
    if Config.ShowFOV then
        FOVCircle.Position = GetFOVCenter()
    end

    if Config.AimbotEnabled and IsAimPressed() then
        local target = GetClosestPlayer()
        if target then
            Camera.CFrame = Camera.CFrame:Lerp(
                CFrame.new(Camera.CFrame.Position, target.Position),
                1 / Config.Smoothness
            )
        end
    end

    UpdateESP()
    UpdateSnapLines()
    UpdateDroppedTools()
end)

RunService.Heartbeat:Connect(function(dt)
    for _, player in ipairs(Players:GetPlayers()) do
        if Config.HitboxEnabled then
            ApplyHitbox(player)
        else
            ResetHitbox(player)
        end
    end

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hum and hrp then
            if hum.WalkSpeed ~= Config.WalkSpeed then hum.WalkSpeed = Config.WalkSpeed end
            if hum.UseJumpPower and hum.JumpPower ~= Config.JumpPower then hum.JumpPower = Config.JumpPower end

            if Config.NoClip then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end

            if Config.SpinBot then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Config.SpinSpeed), 0)
            end

            if Config.Fly then
                local moveDir = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end
                if moveDir.Magnitude > 0 then moveDir = moveDir.Unit * Config.FlySpeed end
                hrp.Velocity = moveDir
                hrp.RotVelocity = Vector3.zero
            end
        end
    end

    for obj, drawing in pairs(DroppedToolCache) do
        if not obj.Parent then
            drawing:Remove()
            DroppedToolCache[obj] = nil
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if ESPCache[p] then
        for _, d in pairs(ESPCache[p]) do
            if typeof(d) == "table" then
                for _, b in ipairs(d) do b:Remove() end
            else
                d:Remove()
            end
        end
        ESPCache[p] = nil
    end
    if SnapLineCache[p] then
        SnapLineCache[p]:Remove()
        SnapLineCache[p] = nil
    end
end)

