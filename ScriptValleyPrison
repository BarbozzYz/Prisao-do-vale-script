local aimKeyMap = {
    MouseButton1 = Enum.UserInputType.MouseButton1,
    MouseButton2 = Enum.UserInputType.MouseButton2,
}

local function IsAimPressed()
    if aimKeyMap[Config.AimKey] then
        return UserInputService:IsMouseButtonPressed(aimKeyMap[Config.AimKey])
    end
    local k = Enum.KeyCode[Config.AimKey]
    return k and UserInputService:IsKeyDown(k) or false
end

